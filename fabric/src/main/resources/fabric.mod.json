{
  "schemaVersion": 1,
  "id": "clientinvinteractions",
  "version": "${version}",
  "name": "Client Inventory Interactions",
  "description": "Client-side merge, move-all, take-all and sort buttons for chests and other container screens. Works on servers without the mod.",
  "authors": ["ViribusEgoVis"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.viribusegovis.clientinvinteractions.fabric.ClientInvInteractions"],
    "modmenu": ["com.viribusegovis.clientinvinteractions.fabric.ModMenuIntegration"]
  },
  "accessWidener": "clientinvinteractions.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
